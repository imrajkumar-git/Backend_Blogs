# Copy to `.env` and adjust. Never commit the real .env.

# Development: DEBUG=True. In production set DEBUG=False and a long random SECRET_KEY.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Hosts Django will answer to. Add your LAN IP if the frontend reaches the API
# by IP (the frontend's fallback URL is http://192.168.0.120:8000).
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins of the Next.js frontend that may call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only needed when serving the Django admin over HTTPS behind a proxy.
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# Set to True in production when the site is served over HTTPS.
# USE_HTTPS=True

# TIME_ZONE=Asia/Dubai
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=7
# BLOG_COVER_MAX_BYTES=5242880
# AVATAR_MAX_BYTES=5242880
